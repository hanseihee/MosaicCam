    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلتقط صورًا لإخفاء لوحات السيارات والوجوه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa fotos per amagar matrícules i cares."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotí snímky pro zakrytí SPZ a obličejů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tager billeder for at skjule nummerplader og ansigter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt Fotos auf, um Kennzeichen und Gesichter zu verbergen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβά φωτογραφίες για απόκρυψη πινακίδων και προσώπων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes photos so you can hide license plates and faces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace fotos para ocultar matrículas y caras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottaa kuvia rekisterikilpien ja kasvojen peittämiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend des photos pour masquer plaques et visages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלם תמונות כדי להסתיר לוחיות רישוי ופנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नंबर प्लेट और चेहरे छिपाने के लिए फ़ोटो लेता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snima fotografije za skrivanje tablica i lica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotókat készít rendszámok és arcok eltakarásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil foto untuk menyamarkan pelat nomor dan wajah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta foto per nascondere targhe e volti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナンバープレートや顔を隠す写真を撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번호판과 얼굴을 가릴 사진을 찍습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil foto untuk menyembunyikan plat nombor dan wajah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bilder for å skjule skilt og ansikter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt foto’s om kentekens en gezichten te verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Robi zdjęcia, aby ukryć tablice i twarze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira fotos para ocultar placas e rostos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira fotografias para ocultar matrículas e rostos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Face poze pentru a ascunde numere și fețe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимает фото, чтобы скрыть номера и лица."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotí snímky na zakrytie ŠPZ a tvárí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar foton för att dölja registreringsskyltar och ansikten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายรูปเพื่อเบลอป้ายทะเบียนและใบหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plakaları ve yüzleri gizlemek için fotoğraf çeker."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімає фото, щоб приховати номери й обличчя."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp ảnh để che biển số và khuôn mặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拍摄需要遮挡车牌和人脸的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於拍攝需要遮蔽車牌和人臉的照片。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ الصورة المشوّشة في الصور."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa la foto pixelada a Fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládá rozpixelovanou fotku do Fotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer det slørede billede i Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert das verpixelte Foto in Fotos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύει τη θολωμένη φωτογραφία στις Φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the pixelated photo to your Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la foto pixelada en Fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa pikselöidyn kuvan Kuviin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre la photo pixelisée dans Photos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר את התמונה המפוקסלת בתמונות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छिपाई गई फ़ोटो को फ़ोटो ऐप में सेव करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprema pikseliziranu fotografiju u Fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pixelesített fotót a Fotókba menti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan foto yang disamarkan ke Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva la foto pixelata in Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モザイクをかけた写真を写真アプリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모자이크한 사진을 사진 앱에 저장합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan foto bermozek ke Foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrer det sladdede bildet i Bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart de gepixelde foto in Foto’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje zapikselowane zdjęcie w Zdjęciach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva a foto pixelada em Fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda a fotografia pixelizada em Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează poza pixelată în Poze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет замазанное фото в Фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukladá rozpixelovanú fotku do Fotiek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar det pixlade fotot i Bilder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรูปที่เบลอแล้วลงรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mozaiklenmiş fotoğrafı Fotoğraflar’a kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає замазане фото у Фото."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ảnh đã che vào Ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将打码后的照片保存到照片中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將打碼後的照片儲存到照片中。"
          }
        }
      }
    },
    "NSUserTrackingUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم لعرض إعلانات أكثر ملاءمة. يعمل التطبيق كما هو إن لم تسمح."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’usa per mostrar anuncis més rellevants. L’app funciona igual si no ho permets."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slouží k zobrazování relevantnější reklamy. Bez povolení aplikace funguje stejně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges til mere relevante reklamer. Appen virker på samme måde, hvis du afviser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dient für relevantere Werbung. Die App funktioniert auch ohne Erlaubnis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιείται για πιο σχετικές διαφημίσεις. Η εφαρμογή λειτουργεί το ίδιο χωρίς άδεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show more relevant ads. The app works the same if you don’t allow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para mostrar anuncios más relevantes. La app funciona igual si no lo permites."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytetään osuvampien mainosten näyttämiseen. Sovellus toimii samoin ilman lupaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert à afficher des pubs plus pertinentes. L’app fonctionne pareil si vous refusez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משמש להצגת פרסומות רלוונטיות יותר. האפליקציה עובדת אותו דבר גם בלי אישור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा प्रासंगिक विज्ञापन दिखाने के लिए। अनुमति न देने पर भी ऐप वैसे ही चलेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi se za relevantnije oglase. Aplikacija radi jednako i bez dopuštenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Relevánsabb hirdetésekhez használjuk. Az app engedély nélkül is ugyanúgy működik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipakai untuk menampilkan iklan yang lebih relevan. Aplikasi tetap berjalan jika tidak diizinkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve a mostrare annunci più pertinenti. L’app funziona comunque se rifiuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より関連性の高い広告を表示するために使います。許可しなくてもアプリはそのまま使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고를 더 알맞게 보여 주는 데 씁니다. 허용하지 않아도 앱은 그대로 쓸 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan untuk memaparkan iklan yang lebih relevan. Aplikasi berfungsi sama jika tidak dibenarkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukes til mer relevante annonser. Appen fungerer likt om du ikke tillater det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor relevantere advertenties. De app werkt hetzelfde als je het niet toestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Służy do wyświetlania trafniejszych reklam. Aplikacja działa tak samo bez zgody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para mostrar anúncios mais relevantes. O app funciona igual se você não permitir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para mostrar anúncios mais relevantes. A app funciona na mesma se não permitir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosit pentru reclame mai relevante. Aplicația funcționează la fel și fără permisiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для показа более подходящей рекламы. Без разрешения приложение работает так же."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slúži na zobrazovanie relevantnejšej reklamy. Bez povolenia aplikácia funguje rovnako."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används för mer relevanta annonser. Appen fungerar likadant om du nekar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เพื่อแสดงโฆษณาที่ตรงกับคุณมากขึ้น ไม่อนุญาตก็ใช้แอปได้ตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha ilgili reklamlar göstermek için kullanılır. İzin vermeseniz de uygulama aynı çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується для показу доречнішої реклами. Без дозволу застосунок працює так само."
          }
        },
        "vi": {
          "stringUnit": {
