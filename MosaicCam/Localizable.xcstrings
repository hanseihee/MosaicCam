    "저장할 때 나오는 광고를 없애요.\n한 번 사면 이 Apple 계정으로 계속 쓸 수 있어요.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الإعلان الذي يظهر عند الحفظ.\nاشترِ مرة واحدة واحتفظ به على حساب Apple هذا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Treu l’anunci que apareix en desar.\nCompra’l un cop i conserva’l en aquest compte d’Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní reklamu při ukládání.\nKoupíte jednou a zůstane na tomto účtu Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner reklamen, der vises, når du gemmer.\nKøb én gang, og behold den på denne Apple-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die Werbung beim Speichern.\nEinmal kaufen, dauerhaft mit diesem Apple Account nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί τη διαφήμιση κατά την αποθήκευση.\nΜία αγορά, μόνιμα σε αυτόν τον λογαριασμό Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the ad shown when you save.\nBuy once and keep it on this Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita el anuncio que aparece al guardar.\nCómpralo una vez y consérvalo en esta cuenta de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa tallennettaessa näytettävän mainoksen.\nOsta kerran, pysyy tällä Apple-tilillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime la pub affichée à l’enregistrement.\nAchat unique, conservé sur ce compte Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיר את הפרסומת שמוצגת בשמירה.\nקנייה אחת, נשמר בחשבון Apple הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव करते समय दिखने वाला विज्ञापन हटाता है।\nएक बार खरीदें और इस Apple खाते पर हमेशा रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja oglas koji se prikazuje pri spremanju.\nKupi jednom i zadrži na ovom Apple računu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja a mentéskor megjelenő hirdetést.\nEgyszer veszed meg, és ezen az Apple-fiókon megmarad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus iklan yang muncul saat menyimpan.\nBeli sekali, berlaku terus di Akun Apple ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove l’annuncio mostrato al salvataggio.\nAcquisto unico, valido su questo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存のときに出る広告をなくします。\n一度買えば、このApple アカウントでずっと使えます。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang iklan yang muncul semasa menyimpan.\nBeli sekali, kekal pada Akaun Apple ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner annonsen som vises når du lagrer.\nKjøp én gang og behold på denne Apple-kontoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert de advertentie bij het opslaan.\nEenmalig kopen, blijft op dit Apple-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa reklamę wyświetlaną przy zapisie.\nKupujesz raz i masz na stałe na tym koncie Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o anúncio exibido ao salvar.\nCompre uma vez e use sempre nesta Conta Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o anúncio mostrado ao guardar.\nCompre uma vez e use sempre nesta Conta Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină reclama afișată la salvare.\nCumperi o dată și rămâne pe acest cont Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирает рекламу при сохранении.\nПокупается один раз и остаётся на этом Apple Account."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni reklamu pri ukladaní.\nKúpite raz a ostane na tomto účte Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort annonsen som visas när du sparar.\nKöp en gång och behåll på detta Apple-konto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบโฆษณาที่แสดงตอนบันทึก\nซื้อครั้งเดียว ใช้ได้ตลอดกับบัญชี Apple นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydederken çıkan reklamı kaldırır.\nBir kez satın alın, bu Apple Hesabı’nda kalıcı olsun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибирає рекламу під час збереження.\nКупується один раз і залишається на цьому Apple Account."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ quảng cáo hiện khi lưu.\nMua một lần, dùng mãi với Tài khoản Apple này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉保存时显示的广告。\n购买一次，此 Apple 账户可长期使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除儲存時顯示的廣告。\n購買一次，此 Apple 帳戶可永久使用。"
          }
        }
      }
    },
