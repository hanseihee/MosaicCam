{
  "sourceLanguage": "ko",
  "strings": {
    "%@에 광고 제거": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة الإعلانات مقابل %@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Treu els anuncis per %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranit reklamy za %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern reklamer for %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung entfernen für %@"
          }
