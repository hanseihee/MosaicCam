    "**광고 없이**\n바로 저장하기": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**احفظ فورًا**\nبدون إعلانات"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desa a l’instant,**\nsense anuncis"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ukládejte hned,**\nbez reklam"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gem med det samme,**\nuden reklamer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sofort speichern,**\nohne Werbung"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Αποθήκευση αμέσως,**\nχωρίς διαφημίσεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Save right away,**\nno ads"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Guarda al instante,**\nsin anuncios"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tallenna heti,**\nilman mainoksia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Enregistrez direct,**\nsans pub"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**שמירה מיידית,**\nבלי פרסומות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**तुरंत सेव करें,**\nबिना विज्ञापन"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Spremi odmah,**\nbez oglasa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mentés azonnal,**\nreklámok nélkül"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Simpan langsung,**\ntanpa iklan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Salva subito,**\nsenza pubblicità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**広告なしで**\nすぐに保存"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "**Simpan terus,**\ntanpa iklan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Lagre med en gang,**\nuten annonser"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Direct opslaan,**\nzonder reclame"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Zapisuj od razu,**\nbez reklam"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Salve na hora,**\nsem anúncios"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "**Guarde logo,**\nsem anúncios"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**Salvează imediat,**\nfără reclame"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Сохраняйте сразу,**\nбез рекламы"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ukladajte hneď,**\nbez reklám"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Spara direkt,**\nutan annonser"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**บันทึกได้ทันที**\nไม่มีโฆษณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hemen kaydet,**\nreklamsız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Зберігайте одразу,**\nбез реклами"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Lưu ngay,**\nkhông quảng cáo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**没有广告**\n直接保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**沒有廣告**\n直接儲存"
          }
        }
      }
    },
    "**번호판과 얼굴을**\n찾아서 가려 드려요": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**يعثر على اللوحات والوجوه**\nلتخفيها"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "**Troba matrícules i cares**\nperquè les amaguis"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Najde SPZ a obličeje**\nk zakrytí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Finder nummerplader og ansigter,**\nså du kan skjule dem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Findet Kennzeichen und Gesichter**\nzum Verpixeln"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Βρίσκει πινακίδες και πρόσωπα**\nγια να τα κρύψεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Finds plates and faces**\nso you can hide them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Encuentra matrículas y caras**\npara que las ocultes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Löytää rekisterikilvet ja kasvot**\npeitettäviksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Repère plaques et visages**\npour les masquer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**מוצא לוחיות ופנים**\nכדי שתוכלו להסתיר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**नंबर प्लेट और चेहरे ढूँढता है**\nताकि आप उन्हें छिपा सकें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pronalazi tablice i lica**\nkoje možeš sakriti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "**Megtalálja a rendszámokat és arcokat,**\nhogy eltakard"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Menemukan pelat dan wajah**\nuntuk kamu samarkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trova targhe e volti**\nda nascondere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**ナンバーと顔を見つけて**\nサッと隠せます"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mencari plat dan wajah**\nuntuk anda sembunyikan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Finner skilt og ansikter**\nså du kan skjule dem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vindt kentekens en gezichten**\nom te verbergen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Znajduje tablice i twarze**\ndo zasłonięcia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Encontra placas e rostos**\npara você ocultar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "**Encontra matrículas e rostos**\npara os ocultar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**Găsește numere și fețe**\nca să le ascunzi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Находит номера и лица,**\nчтобы их скрыть"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nájde ŠPZ a tváre**\nna zakrytie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hittar skyltar och ansikten**\nså du kan dölja dem"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**หาป้ายทะเบียนและใบหน้า**\nให้คุณเบลอได้ทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Plakaları ve yüzleri bulur,**\nsiz gizlersiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Знаходить номери й обличчя,**\nщоб їх приховати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tìm biển số và khuôn mặt**\nđể bạn che đi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**自动找到车牌和人脸**\n一键打码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**自動找出車牌和人臉**\n輕鬆打碼"
          }
        }
      }
    },
