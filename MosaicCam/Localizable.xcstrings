    "이 Apple 계정으로 산 기록이 없어요.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عملية شراء لحساب Apple هذا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha trobat cap compra amb aquest compte d’Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento účet Apple nebyl nalezen žádný nákup."
          }
