    "가릴 곳을 탭하면 모자이크돼요": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على ما تريد تشويشه"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el que vulguis pixelar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím rozpixelujete"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at sløre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antippen, um zu verpixeln"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ό,τι θέλετε να θολώσετε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap anything to pixelate it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca lo que quieras pixelar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta pikselöidäksesi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ce que vous voulez pixeliser"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על מה שתרצו לפקסל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसे छिपाना हो उस पर टैप करें"
          }
