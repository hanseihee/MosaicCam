    "승인을 기다리고 있어요. 승인되면 자동으로 적용돼요.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار الموافقة. سيُطبَّق تلقائيًا بعد الموافقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperant l’aprovació. S’aplicarà automàticament quan s’aprovi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeká se na schválení. Po schválení se použije automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på godkendelse. Anvendes automatisk, når det er godkendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf Genehmigung. Wird nach Genehmigung automatisch aktiviert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναμονή έγκρισης. Θα εφαρμοστεί αυτόματα μόλις εγκριθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval. It will apply automatically once approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Se aplicará automáticamente al aprobarse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan hyväksyntää. Tulee voimaan automaattisesti hyväksynnän jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’approbation. Ce sera appliqué automatiquement une fois approuvé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין לאישור. יופעל אוטומטית לאחר האישור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मंज़ूरी का इंतज़ार है। मंज़ूरी मिलते ही अपने आप लागू हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeka se odobrenje. Primijenit će se automatski nakon odobrenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jóváhagyásra vár. Jóváhagyás után automatikusan érvénybe lép."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu persetujuan. Akan diterapkan otomatis setelah disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di approvazione. Verrà applicato automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認を待っています。承認されると自動的に適用されます。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu kelulusan. Akan digunakan secara automatik selepas diluluskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på godkjenning. Tas i bruk automatisk når det er godkjent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht op goedkeuring. Wordt automatisch toegepast na goedkeuring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na zatwierdzenie. Zostanie zastosowane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. Será aplicado automaticamente quando aprovado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aguardar aprovação. Será aplicado automaticamente quando aprovado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se așteaptă aprobarea. Se va aplica automat după aprobare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидается одобрение. Применится автоматически после одобрения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čaká sa na schválenie. Po schválení sa použije automaticky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på godkännande. Tillämpas automatiskt när det godkänts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรออนุมัติ เมื่ออนุมัติแล้วจะมีผลอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay bekleniyor. Onaylanınca otomatik uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікується схвалення. Застосується автоматично після схвалення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ phê duyệt. Sẽ tự áp dụng khi được duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待批准，批准后会自动生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待核准，核准後會自動生效。"
          }
        }
      }
    },
